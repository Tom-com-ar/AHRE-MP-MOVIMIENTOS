    },
    {
      "parameters": {
        "jsCode": "const response = $json;\nconst payments = Array.isArray(response.results) ? response.results.slice(0, 2) : [];\nconst safeResults = payments.map((p) => ({ id: p.id ?? null, date_created: p.date_created ?? null, date_approved: p.date_approved ?? null, status: p.status ?? null, status_detail: p.status_detail ?? null, transaction_amount: p.transaction_amount ?? null, currency_id: p.currency_id ?? null, operation_type: p.operation_type ?? null, payment_type_id: p.payment_type_id ?? null, payment_method_id: p.payment_method_id ?? null }));\nreturn [{ json: { ok: true, total: response.paging?.total ?? safeResults.length, shown: safeResults.length, results: safeResults } }];"
      },
